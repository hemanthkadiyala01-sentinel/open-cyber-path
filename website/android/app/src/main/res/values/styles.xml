<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>



        <!-- Normal theme used by the WebView and native popup windows after launch. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#06121d</item>
        <item name="android:colorBackground">#06121d</item>
            <item name="actionModePopupWindowStyle">@style/OpenCyberPathTextSelectionPopupWindow</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Use native splash attributes, not a full-screen bitmap as the window background. -->
        <item name="windowSplashScreenBackground">@color/colorPrimaryDark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- A solid fallback prevents the splash bitmap from appearing in WebView popup windows. -->
        <item name="android:background">@color/colorPrimaryDark</item>
    </style>


    <!-- Avoid painting a full-window theme background behind WebView text-selection actions. -->
    <style name="OpenCyberPathTextSelectionPopupWindow" parent="Widget.AppCompat.PopupWindow">
        <item name="android:popupBackground">@android:color/transparent</item>
    </style>
</resources>