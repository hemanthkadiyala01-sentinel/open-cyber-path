# Copy to .env.staging and replace every placeholder.
# All three DNS A records must point to the VPS public IPv4 address.
WEB_DOMAIN=stage.example.com
API_DOMAIN=api-stage.example.com
AUTH_DOMAIN=auth-stage.example.com
ACME_EMAIL=staging-admin@example.com

# Use separately generated random 64-character lowercase hexadecimal strings.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_CHAR_HEX
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX
APP_OWNER_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX
APP_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX
DATABASE_CONTEXT_HMAC_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
KEYCLOAK_ADMIN_USERNAME=ocp-staging-bootstrap
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
