# Copy this to .env locally. Never commit .env.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# Use the restricted runtime login for normal API queries.
DATABASE_URL=postgresql://opencyberpath_runtime:CHANGE_ME_RUNTIME_PASSWORD@127.0.0.1:5432/opencyberpath
# Used only by `npm run migrate`; use the separate owner login.
MIGRATION_DATABASE_URL=postgresql://opencyberpath_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:5432/opencyberpath

OIDC_ISSUER_URL=http://localhost:8081/realms/opencyberpath
OIDC_AUDIENCE=opencyberpath-api
# Local dev only. Use true only when PostgreSQL is configured for verified TLS.
DATABASE_SSL=false
# Generate at least 32 random bytes and encode as hex. Keep this separate from database passwords.
DATABASE_CONTEXT_HMAC_SECRET=CHANGE_ME_WITH_64_OR_MORE_HEX_CHARACTERS
