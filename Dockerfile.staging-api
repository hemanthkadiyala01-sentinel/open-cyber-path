FROM node:22-bookworm-slim

ENV NODE_ENV=staging \
    HOST=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl python3 python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# Keep the repository root as the Docker build context so the API can access
# shared database migrations, the live-feed collector, and the published snapshot.
WORKDIR /app/backend
COPY backend/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY backend/ ./
COPY database/migrations/ /app/database/migrations/
COPY tools/liveops/ /app/tools/liveops/
COPY website/public/live-case-intelligence.json /app/website/public/live-case-intelligence.json

# Install Python dependencies only if the collector declares them in a requirements file.
RUN if [ -f /app/tools/liveops/requirements.txt ]; then \
      python3 -m pip install --break-system-packages --no-cache-dir -r /app/tools/liveops/requirements.txt; \
    fi

RUN npm run build

EXPOSE 3000

# Staging only: apply the existing idempotent migrations before starting the API.
# If migration fails, the service fails visibly rather than serving without the schema.
CMD ["sh", "-lc", "npm run migrate && exec npm run start"]
